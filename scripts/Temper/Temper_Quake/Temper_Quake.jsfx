noindex: true
version: 1.0.0
author: Temper Tools
desc:Temper Quake
// Turns the incoming sound into a stereo haptic signal for a game controller's
// left and right grips. Five macros, each with one job, and Output, the final
// level after all of them:
//   Intensity  how strong            Weight   where the energy sits
//   Punch      the shape over time   Texture  the surface (smooth -> rough)
//   Focus      which part of the sound is felt (low body <- all -> high detail)
// What lies above the controller's reach gets no tone of its own: it is shifted
// down as it is, into 200 to 500 Hz, higher for a brighter sound. The one tone
// the FX makes sits under the tails that Punch's left side stretches.
//
// This file is a TRANSCRIPTION of lib/temper_quake_engine.lua (the "twin"):
// the same order, the same constant names (C_<NAME> here, E.C.<NAME> there),
// the same arithmetic. Change the twin first, keep its tests green, then
// change this file, and run tests/probes/quake/probe_parity.lua.
//
// All state that matters is in the sliders, so a project renders the same with
// the Temper Quake window closed. Random sources are a hash of the timeline
// sample and every envelope resets on a transport start or jump, so a print
// repeats exactly. The slider block is generated by tools/gen_quake_sliders.lua
// from lib/temper_quake_layout.lua and is append-only.

in_pin:in L
in_pin:in R
out_pin:haptic L
out_pin:haptic R

slider1:100<0,200,0.1>Intensity
slider2:0<-100,100,0.1>Weight
slider3:0<-100,100,0.1>Punch
slider4:0<0,100,0.1>Texture
slider5:50<0,100,0.1>Focus
slider6:100<0,200,0.1>Output
slider7:0<0,2,1>-input
slider8:100<0,100,0.1>Left
slider9:100<0,100,0.1>Right
slider10:0<0,1,1{Off,On}>Link sides
slider11:0<-24,24,0.1>Sensitivity dB
slider12:60<20,500,0.1>-anchor_hz
slider13:250<100,400,0.1>-light_hz
slider14:1000<100,2000,1>-ceiling_hz
slider15:1<0,1,0.0001>-out_ceiling
slider16:5.5<-24,24,0.1>-eq_90
slider17:6.5<-24,24,0.1>-eq_130
slider18:8.4<-24,24,0.1>-eq_180
slider19:11.5<-24,24,0.1>-eq_250
slider20:1<0,65535,1>-seed
slider21:0<0,1,0.0001>-peak_l
slider22:0<0,1,0.0001>-peak_r
slider23:0<0,1,0.0001>-activity
slider24:3<3,3,1>-version

@init
ext_noinit = 1;

// ---- constants: the same names and values as E.C in the twin ----
C_REF_PEAK = 0.126;
C_DC_HZ = 15;
C_XOVER_HZ = 200;
C_FOCUS_MATCH_DB = 12;
C_FOCUS_HP_FROM = 30;
C_FOCUS_HP_HZ = 220;
C_FOCUS_HP_BLEND = 10;
C_FAST_UP_MS = 1;
C_FAST_DN_MS = 15;
C_SLOW_UP_MS = 20;
C_SLOW_DN_MS = 150;
C_SMOOTH_MS = 10;
C_FOLD_HZ = 500;
C_FOLD_HP_HZ = 200;
C_FOLD_IN_HZ = 12000;
C_COLOR_HZ = 1550;
C_COLOR_OUT_HZ = 316;
C_FOLD_DN_MS = 8;
C_FOLD_GAIN = 4.5;
C_FOLD_FLOOR = 0.08;
C_FOLD_LINE_HZ = 409;
C_FOLD_LINE_RATIO = 1.4983;
C_FOLD_LINE_COUNT = 9;
C_BREAK_HZ = 110;
C_TILT_MATCH_DB = 18;
C_PUNCH_BOOST_DB = 30;
C_PUNCH_CUT_DB = 30;
C_PUNCH_SLOPE = 3;
C_PUNCH_HIT_RISE = 2;
C_PUNCH_QUICK_MS = 5;
C_PUNCH_RISE_MS = 40;
C_PUNCH_FALL_MS = 180;
C_PUNCH_EPS = 0.0005;
C_SUSTAIN_MAX_MS = 475;
C_SOFTEN_EXP = 0.75;
C_PUNCH_SOFT_DB = 0;
C_SILENCE = 0.000001;
C_GRIT_HZ = 50;
C_GRIT_EDGE = 10;
C_GRIT_BIAS = 0.08;
C_GRIT_TRIM_DB = 4;
C_GRIT_HIT_FROM = 1.3;
C_TEXTURE_BLEND_MS = 3;
C_INT_FLOOR_DB = 46;
C_INT_MID_DB = 11.5;
C_INT_TOP_DB = 24.5;
C_INT_OPEN_DB = 6;
C_DENSE_FROM_DB = 8.75;
C_DENSE_FULL_DB = 17.5;
C_DENSE_K = 4;
C_OUT_FLOOR_DB = 40;
C_OUT_TOP_DB = 24;

// ---- per-side state: S_X[c], c = 0 left, 1 right ----
S_DCX = 0; S_DCY = 2; S_LO1 = 4; S_LO2 = 6; S_LO3 = 8; S_LO4 = 10;
S_HI1 = 12; S_HI2 = 14; S_HI3 = 16; S_HI4 = 18;
S_FAST = 20; S_SLOW = 22; S_FL1 = 24; S_FL2 = 26; S_TL1 = 28; S_TL2 = 30;
S_TH1 = 32; S_TH2 = 34; S_TE_PRE = 36; S_TE_POST = 38; S_PO1 = 40; S_PO2 = 42;
S_TB = 44; S_G = 46; S_HOLD = 48; S_PA = 50; S_PB = 52; S_PC = 54; S_HM = 56; S_IE = 58;
S_HE = 60; S_FI1 = 62; S_FI2 = 64; S_FM = 66; S_FH1 = 68; S_FH2 = 70; S_FA = 72; S_FD = 74;
S_HL1 = 76; S_HL2 = 78; S_HL3 = 80; S_HL4 = 82; S_HI5 = 84; S_HI6 = 86;
S_CL1 = 88; S_CL2 = 90; S_CH1 = 92; S_CH2 = 94; S_ED = 96; S_EB = 98;
S_RO1 = 100; S_RO2 = 102; S_RH1 = 104; S_RH2 = 106;
S_OH1 = 108; S_OH2 = 110; S_OH3 = 112; S_OH4 = 114;
STATE_SIZE = 116;
// the equal-strength table, five points sorted by frequency
PT_F = 120; PT_G = 128;
// the lines that shift the high part down: radians per sample, and where each clock stands
LINE_W = 136; LINE_TH = 148;

function tanh_(x) local(e)
(
  x > 20 ? 1 : x < -20 ? -1 : ( e = exp(2 * x); (e - 1) / (e + 1); );
);

function pole_ms(ms)
(
  exp(-1 / (max(ms, 0.01) * 0.001 * srate));
);

function lp_k(hz)
(
  1 - exp(-2 * $pi * hz / srate);
);

// A repeatable number in [0, 1) from two integers, unrelated from one integer
// to the next; exact in doubles, so it is the same number the twin gets.
// Written with floor, never with %. Each round multiplies the value's low half
// with its high half (see the twin for why one straight line was not enough).
function hash(seed, k) local(m, h, hi, lo)
(
  m = 2147483647;
  h = k * 48271 + seed * 69621;
  h = h - floor(h / m) * m;
  loop(2,
    hi = floor(h / 46337);
    lo = h - hi * 46337;
    h = lo * hi + lo * 40503 + hi + 12345;
    h = h - floor(h / m) * m;
    h = h * 48271;
    h = h - floor(h / m) * m;
  );
  h / m;
);

function follow(value, r, up, down)
(
  r > value ? r + up * (value - r) : r + down * (value - r);
);

function clamp(v, lo, hi)
(
  v < lo ? lo : v > hi ? hi : v;
);

function setsl(idx, v)
(
  abs(v - slider(idx)) > 0.000001 ? ( slider(idx) = v; );
);

// INTENSITY's gain into the saturator: two straight lines in dB, from the
// floor to "passes at its own level" at 1 (the knob's 100), and on up to the
// top at 2 (the knob's 200).
function intensity_gain(i) local(db)
(
  i <= 0.0001 ? 0 : (
    db = i <= 1 ? -C_INT_FLOOR_DB + (C_INT_FLOOR_DB - C_INT_MID_DB) * i
                : -C_INT_MID_DB + (C_INT_MID_DB + C_INT_TOP_DB) * (i - 1);
    10 ^ (db / 20);
  );
);

// OUTPUT's gain: two straight lines in dB, from the floor up to "as it is" at
// 1 (the knob's 100), and on up to the top at 2 (the knob's 200).
function output_gain(o)
(
  o <= 0.0001 ? 0 : o <= 1 ? 10 ^ (-C_OUT_FLOOR_DB * (1 - o) / 20) : 10 ^ (C_OUT_TOP_DB * (o - 1) / 20);
);

// dB a carrier at hz must be raised to feel as strong as one at the anchor:
// straight lines on a log-frequency axis through the table, flat beyond it.
function comp_db(hz) local(i, out, done, u)
(
  hz <= PT_F[0] ? PT_G[0] : (
    out = PT_G[4];
    done = 0;
    i = 1;
    loop(4,
      !done ? (
        hz == PT_F[i] ? ( out = PT_G[i]; done = 1; )
        : hz < PT_F[i] ? (
          u = log(hz / PT_F[i - 1]) / log(PT_F[i] / PT_F[i - 1]);
          out = PT_G[i - 1] + u * (PT_G[i] - PT_G[i - 1]);
          done = 1;
        );
      );
      i += 1;
    );
    out;
  );
);

function side_defaults()
(
  S_G[0] = 1;
  S_G[1] = 1;
);

// A transport start or jump: clear every envelope and filter, snap the knobs,
// and set the carrier clock and the shifting lines from the timeline.
function reset_state(start) local(hz0, cycles, li, turns)
(
  memset(0, 0, STATE_SIZE);
  side_defaults();
  n = start;
  li = 0;
  loop(C_FOLD_LINE_COUNT,
    turns = LINE_W[li] * start / (2 * $pi);
    LINE_TH[li] = 2 * $pi * (turns - floor(turns));
    li += 1;
  );
  cur_intensity = p_intensity; cur_weight = p_weight; cur_punch = p_punch;
  cur_texture = p_texture; cur_focus = p_focus; cur_output = p_output;
  cur_left = p_left; cur_right = p_right;
  hz0 = p_light_hz * (p_anchor_hz / p_light_hz) ^ ((p_weight + 100) / 200);
  cycles = hz0 * start / srate;
  phase = 2 * $pi * (cycles - floor(cycles));
  pk_l = 0; pk_r = 0; pk_in = 0;
);

was_playing = 0;
last_pos = 0;
n = 0;
need_reset = 1;
clear_sides = 0;

@slider
p_intensity = slider(1);
p_weight = slider(2);
p_punch = slider(3);
p_texture = slider(4);
p_focus = slider(5);
p_output = slider(6);
p_input = slider(7);
p_left = slider(8);
p_right = slider(9);
p_link = slider(10);
p_sensitivity = slider(11);
p_anchor_hz = slider(12);
p_light_hz = slider(13);
p_ceiling_hz = slider(14);
p_out_ceiling = slider(15);
p_eq_90 = slider(16);
p_eq_130 = slider(17);
p_eq_180 = slider(18);
p_eq_250 = slider(19);
p_seed = slider(20);

k_smooth = 1 - pole_ms(C_SMOOTH_MS);
k_xover = lp_k(C_XOVER_HZ);
k_ceiling = lp_k(p_ceiling_hz);
k_break = lp_k(C_BREAK_HZ);
tilt_match = 10 ^ (C_TILT_MATCH_DB / 20);
punch_lo = 10 ^ (-C_PUNCH_CUT_DB / 20);
punch_hi = 10 ^ (C_PUNCH_BOOST_DB / 20);
dense_norm = 1 / tanh_(C_DENSE_K);
k_pa = 1 - pole_ms(C_PUNCH_QUICK_MS);
k_pb = 1 - pole_ms(C_PUNCH_RISE_MS);
k_pc = pole_ms(C_PUNCH_FALL_MS);
k_hm = pole_ms(C_PUNCH_FALL_MS * 2);
punch_dn = pole_ms(C_PUNCH_QUICK_MS);
k_tex = 1 - pole_ms(C_TEXTURE_BLEND_MS);
grit_n = srate / C_GRIT_HZ;
k_fold = lp_k(C_FOLD_HZ);
k_fold_hp = lp_k(C_FOLD_HP_HZ);
k_color = lp_k(C_COLOR_HZ);
k_color_out = lp_k(C_COLOR_OUT_HZ);
// a fourth-order low-pass at C_FOLD_IN_HZ: two second-order sections
in_w0 = 2 * $pi * min(C_FOLD_IN_HZ, 0.45 * srate) / srate;
in_cw = cos(in_w0);
in_sw = sin(in_w0);
in_alpha = in_sw / (2 * 0.5412);
in_b_1 = (1 - in_cw) / 2 / (1 + in_alpha);
in_a1_1 = -2 * in_cw / (1 + in_alpha);
in_a2_1 = (1 - in_alpha) / (1 + in_alpha);
in_alpha = in_sw / (2 * 1.3066);
in_b_2 = (1 - in_cw) / 2 / (1 + in_alpha);
in_a1_2 = -2 * in_cw / (1 + in_alpha);
in_a2_2 = (1 - in_alpha) / (1 + in_alpha);
fold_dn = pole_ms(C_FOLD_DN_MS);
focus_match = 10 ^ (C_FOCUS_MATCH_DB / 20);
si = 0;
loop(C_FOLD_LINE_COUNT,
  LINE_W[si] = 2 * $pi * C_FOLD_LINE_HZ * C_FOLD_LINE_RATIO ^ si / srate;
  si += 1;
);
dc_r = 1 - 2 * $pi * C_DC_HZ / srate;
fast_up = pole_ms(C_FAST_UP_MS);
fast_dn = pole_ms(C_FAST_DN_MS);
slow_up = pole_ms(C_SLOW_UP_MS);
slow_dn = pole_ms(C_SLOW_DN_MS);
sens = 10 ^ (p_sensitivity / 20);

// the equal-strength table, sorted by frequency (the anchor is one of its points)
PT_F[0] = p_anchor_hz; PT_G[0] = 0;
PT_F[1] = 90; PT_G[1] = p_eq_90;
PT_F[2] = 130; PT_G[2] = p_eq_130;
PT_F[3] = 180; PT_G[3] = p_eq_180;
PT_F[4] = 250; PT_G[4] = p_eq_250;
si = 1;
loop(4,
  sj = si;
  while (sj > 0 && PT_F[sj - 1] > PT_F[sj]) (
    sf = PT_F[sj]; PT_F[sj] = PT_F[sj - 1]; PT_F[sj - 1] = sf;
    sg = PT_G[sj]; PT_G[sj] = PT_G[sj - 1]; PT_G[sj - 1] = sg;
    sj -= 1;
  );
  si += 1;
);
// what was brought into reach is raised by what the table says the middle of
// its range needs
fold_gain = C_FOLD_GAIN * 10 ^ (comp_db(sqrt(C_FOLD_HP_HZ * C_FOLD_HZ)) / 20);

@block
playing = play_state & 1;
jumped = playing && (!was_playing || play_position < last_pos
  || play_position > last_pos + max(0.5, 16 * samplesblock / srate));
(jumped || need_reset) ? (
  reset_state(jumped ? floor(play_position * srate + 0.5) : n);
  need_reset = 0;
);
was_playing = playing;
last_pos = play_position;

d_peak_l = max(pk_l, d_peak_l * 0.85);
d_peak_r = max(pk_r, d_peak_r * 0.85);
d_activity = max(min(1, pk_in), d_activity * 0.85);
pk_l = 0; pk_r = 0; pk_in = 0;
setsl(21, d_peak_l);
setsl(22, d_peak_r);
setsl(23, d_activity);

@sample
clear_sides ? ( memset(0, 0, STATE_SIZE); side_defaults(); clear_sides = 0; );

l = spl0;
r = spl1;
p_link >= 0.5 ? ( m = (l + r) * 0.5; l = m; r = m; );

// ---- once per sample: glide the knobs and work out what they mean ----
cur_intensity += k_smooth * (p_intensity - cur_intensity);
cur_weight += k_smooth * (p_weight - cur_weight);
cur_punch += k_smooth * (p_punch - cur_punch);
cur_texture += k_smooth * (p_texture - cur_texture);
cur_focus += k_smooth * (p_focus - cur_focus);
cur_output += k_smooth * (p_output - cur_output);
cur_left += k_smooth * (p_left - cur_left);
cur_right += k_smooth * (p_right - cur_right);

f = cur_focus / 100;
// The high-pass after the saturator: a fourth-order one whose corner rises
// with the right half of Focus (two second-order sections).
focus_up = max(0, 2 * f - 1);
focus_mix = min(1, focus_up * C_FOCUS_HP_BLEND);
hw = 2 * $pi * C_FOCUS_HP_FROM * (C_FOCUS_HP_HZ / C_FOCUS_HP_FROM) ^ focus_up / srate;
hc = cos(hw);
hs = sin(hw);
al = hs / 1.0824;
oh_b1 = (1 + hc) / 2 / (1 + al);
oh_a11 = -2 * hc / (1 + al);
oh_a21 = (1 - al) / (1 + al);
al = hs / 2.6132;
oh_b2 = (1 + hc) / 2 / (1 + al);
oh_a12 = -2 * hc / (1 + al);
oh_a22 = (1 - al) / (1 + al);
gain = (p_intensity <= 0 && cur_intensity < 0.01) ? 0 : intensity_gain(cur_intensity / 100);
dense = clamp(((C_INT_MID_DB + C_INT_TOP_DB) * (cur_intensity / 100 - 1) - C_DENSE_FROM_DB) / (C_DENSE_FULL_DB - C_DENSE_FROM_DB), 0, 1);
pin = p_out_ceiling * 10 ^ (-C_INT_OPEN_DB * (1 - clamp(cur_intensity / 100 - 1, 0, 1)) / 20);
out_gain = (p_output <= 0 && cur_output < 0.01) ? 0 : output_gain(cur_output / 100);

// WEIGHT, from the gliding knob
hz = p_light_hz * (p_anchor_hz / p_light_hz) ^ ((cur_weight + 100) / 200);
carrier = sin(phase) * 10 ^ (comp_db(hz) / 20);

// The lines that shift the high part down. Their clocks run from the timeline,
// so a print repeats.
comb = 0;
li = 0;
loop(C_FOLD_LINE_COUNT,
  th = LINE_TH[li];
  comb = comb + cos(th);
  th = th + LINE_W[li];
  th > 2 * $pi ? th = th - 2 * $pi;
  LINE_TH[li] = th;
  li += 1;
);

tilt = cur_weight / 100;
phase = phase + 2 * $pi * hz / srate;
phase > 2 * $pi ? phase = phase - 2 * $pi;

// TEXTURE, from the gliding knob and the timeline (so a print repeats): a level
// that wanders between repeatable random points C_GRIT_HZ times a second. The
// knob deepens it (down to nothing at 100) and hardens its edges.
tx = cur_texture / 100;
tx < 0.0001 ? tx = 0;
tx > 0 ? (
  pos = n / grit_n;
  gi = floor(pos);
  ha = hash(p_seed, gi);
  hb = hash(p_seed, gi + 1);
  gr = ha + (hb - ha) * (0.5 - 0.5 * cos($pi * (pos - gi)));
  glow = (1 - tx) ^ 3;
  gedge = clamp((gr - 0.5 - C_GRIT_BIAS * tx) * (1 + C_GRIT_EDGE * tx) + 0.5, 0, 1);
  grit = (glow + (1 - glow) * gedge) * 10 ^ (C_GRIT_TRIM_DB * tx / 20);
);

// PUNCH, from the gliding knob
pn = cur_punch / 100;
abs(pn) < 0.0001 ? pn = 0;
pn < 0 ? (
  k_hold = pole_ms(C_FAST_DN_MS * (C_SUSTAIN_MAX_MS / C_FAST_DN_MS) ^ (-pn));
  soft_makeup = 10 ^ (C_PUNCH_SOFT_DB * -pn / 20);
);
n += 1;

// ---- each side ----
c = 0;
loop(2,
  // sensitivity, DC block
  x = (c == 0 ? l : r) * sens;
  weight = (c == 0 ? cur_left : cur_right) / 100;
  d = x - S_DCX[c] + dc_r * S_DCY[c];
  S_DCX[c] = x;
  S_DCY[c] = d;
  abs(d) > pk_in ? pk_in = abs(d);

  // FOCUS: a low part, a high part, and the whole sound in the middle. Both
  // parts are cut steeply (four poles low, six high), so a thump does not leak
  // into "high".
  S_LO1[c] = S_LO1[c] + k_xover * (d - S_LO1[c]);
  S_LO2[c] = S_LO2[c] + k_xover * (S_LO1[c] - S_LO2[c]);
  S_LO3[c] = S_LO3[c] + k_xover * (S_LO2[c] - S_LO3[c]);
  S_LO4[c] = S_LO4[c] + k_xover * (S_LO3[c] - S_LO4[c]);
  S_HI1[c] = S_HI1[c] + k_xover * (d - S_HI1[c]);
  high = d - S_HI1[c];
  S_HI2[c] = S_HI2[c] + k_xover * (high - S_HI2[c]);
  high = high - S_HI2[c];
  S_HI3[c] = S_HI3[c] + k_xover * (high - S_HI3[c]);
  high = high - S_HI3[c];
  S_HI4[c] = S_HI4[c] + k_xover * (high - S_HI4[c]);
  high = high - S_HI4[c];
  S_HI5[c] = S_HI5[c] + k_xover * (high - S_HI5[c]);
  high = high - S_HI5[c];
  S_HI6[c] = S_HI6[c] + k_xover * (high - S_HI6[c]);
  high = high - S_HI6[c];

  // nothing above C_FOLD_IN_HZ counts
  iy1 = in_b_1 * high + S_HL1[c];
  S_HL1[c] = 2 * in_b_1 * high - in_a1_1 * iy1 + S_HL2[c];
  S_HL2[c] = in_b_1 * high - in_a2_1 * iy1;
  iy2 = in_b_2 * iy1 + S_HL3[c];
  S_HL3[c] = 2 * in_b_2 * iy1 - in_a1_2 * iy2 + S_HL4[c];
  S_HL4[c] = in_b_2 * iy1 - in_a2_2 * iy2;
  high = iy2;

  // COLOUR: how bright the high part is, 0 (all of it under C_COLOR_HZ) to 1
  S_CL1[c] = S_CL1[c] + k_color * (high - S_CL1[c]);
  S_CL2[c] = S_CL2[c] + k_color * (S_CL1[c] - S_CL2[c]);
  S_CH1[c] = S_CH1[c] + k_color * (high - S_CH1[c]);
  bright = high - S_CH1[c];
  S_CH2[c] = S_CH2[c] + k_color * (bright - S_CH2[c]);
  bright = bright - S_CH2[c];
  S_ED[c] = follow(S_ED[c], abs(S_CL2[c]), slow_up, slow_dn);
  S_EB[c] = follow(S_EB[c], abs(bright), slow_up, slow_dn);
  colour = S_EB[c] / (S_ED[c] + S_EB[c] + 0.000000001);

  // The high part, brought into reach: shifted down by the lines, scaled to
  // about 1 by its own recent size, and given the high part's own contour.
  S_HE[c] = follow(S_HE[c], abs(high), fast_up, fold_dn);
  S_FI1[c] = S_FI1[c] + k_fold * (high * comb - S_FI1[c]);
  S_FI2[c] = S_FI2[c] + k_fold * (S_FI1[c] - S_FI2[c]);
  S_FM[c] = follow(S_FM[c], abs(S_FI2[c]), slow_up, slow_dn);
  reach = fold_gain * S_HE[c] * S_FI2[c] / max(max(S_FM[c], C_FOLD_FLOOR * S_HE[c]), 0.000000001);
  S_FH1[c] = S_FH1[c] + k_fold_hp * (reach - S_FH1[c]);
  reach = reach - S_FH1[c];
  S_FH2[c] = S_FH2[c] + k_fold_hp * (reach - S_FH2[c]);
  reach = reach - S_FH2[c];
  // ... and placed by its colour: the lower and the upper half of the band it
  // lands in (the upper half is subtracted: added in phase the two cancel
  // where they meet)
  S_RO1[c] = S_RO1[c] + k_color_out * (reach - S_RO1[c]);
  S_RO2[c] = S_RO2[c] + k_color_out * (S_RO1[c] - S_RO2[c]);
  S_RH1[c] = S_RH1[c] + k_color_out * (reach - S_RH1[c]);
  upper = reach - S_RH1[c];
  S_RH2[c] = S_RH2[c] + k_color_out * (upper - S_RH2[c]);
  upper = upper - S_RH2[c];
  dark = sqrt(2 * (1 - colour)) * S_RO2[c];
  brt = -sqrt(2 * colour) * upper;
  reach = dark + brt;

  // sel: the chosen part of the sound itself, which the analysis reads; drive:
  // what is felt. The right half climbs: the sound itself and the darker half
  // of what was brought into reach fade out, and at 100 only the bright half
  // is left, at the top of the band.
  f <= 0.5 ? ( u = 2 * f; sel = (1 - u) * S_LO4[c] + u * d; drive = sel + u * u * reach; )
           : ( u = 2 * f - 1; sel = (1 - u) * d + u * high; drive = (1 - u) * (d + dark) + brt; );

  // held at the strength of the whole sound, over the slow envelope
  S_FA[c] = follow(S_FA[c], abs(d + reach), slow_up, slow_dn);
  S_FD[c] = follow(S_FD[c], abs(drive), slow_up, slow_dn);
  S_FD[c] > 0.000000001 ? (
    fh = S_FA[c] / S_FD[c];
    fh > focus_match ? fh = focus_match;
    fh < 1 / focus_match ? fh = 1 / focus_match;
    sel = sel * fh;
    drive = drive * fh;
  );

  // analysis, on the sound itself (what was brought into reach is slow noise;
  // a quick average of it swings with every cycle)
  ra = abs(sel);
  S_FAST[c] = follow(S_FAST[c], ra, fast_up, fast_dn);
  S_SLOW[c] = follow(S_SLOW[c], ra, slow_up, slow_dn);
  // PUNCH's detectors: two plain averages (up and down at the same pace, so a
  // steady sound reads the same on both) and the level's recent peak. The level
  // is the quick average, or the fast envelope when that is higher: it is up
  // within a millisecond, so the next hit ends a dip at once (rapid fire).
  S_PA[c] = S_PA[c] + k_pa * (ra - S_PA[c]);
  S_PB[c] = S_PB[c] + k_pb * (ra - S_PB[c]);
  top = max(S_PA[c], S_FAST[c]);
  S_PC[c] = max(top, S_PC[c] * k_pc);
  fall = (top + C_PUNCH_EPS) / (S_PC[c] + C_PUNCH_EPS);
  rise = (S_PA[c] + C_PUNCH_EPS) / (S_PB[c] + C_PUNCH_EPS);
  rise < 1 ? rise = 1;

  // the sound itself, band-limited
  S_FL1[c] = S_FL1[c] + k_ceiling * (drive - S_FL1[c]);
  S_FL2[c] = S_FL2[c] + k_ceiling * (S_FL1[c] - S_FL2[c]);

  // WEIGHT on the sound itself: toward the heavy end it fades into only what
  // lies below the break, toward the light end into only what lies above it;
  // level-matched to the untouched voice over the slow envelope
  S_TL1[c] = S_TL1[c] + k_break * (S_FL2[c] - S_TL1[c]);
  S_TL2[c] = S_TL2[c] + k_break * (S_TL1[c] - S_TL2[c]);
  S_TH1[c] = S_TH1[c] + k_break * (S_FL2[c] - S_TH1[c]);
  above = S_FL2[c] - S_TH1[c];
  S_TH2[c] = S_TH2[c] + k_break * (above - S_TH2[c]);
  above = above - S_TH2[c];
  tilt >= 0 ? ( faithful = S_FL2[c] + tilt * (S_TL2[c] - S_FL2[c]); )
            : ( faithful = S_FL2[c] - tilt * (above - S_FL2[c]); );
  S_TE_PRE[c] = follow(S_TE_PRE[c], abs(S_FL2[c]), slow_up, slow_dn);
  S_TE_POST[c] = follow(S_TE_POST[c], abs(faithful), slow_up, slow_dn);
  S_TE_POST[c] > 0.000000001 ? (
    gm = S_TE_PRE[c] / S_TE_POST[c];
    gm > tilt_match ? gm = tilt_match;
    gm < 1 / tilt_match ? gm = 1 / tilt_match;
    faithful = faithful * gm;
  );

  // PUNCH. The left side stretches tails: what a held contour adds after the
  // sound's own level has gone rides the carrier.
  tail = 0;
  pn < 0 ? ( S_HOLD[c] = max(S_FAST[c], S_HOLD[c] * k_hold); tail = (S_HOLD[c] - S_FAST[c]) * carrier; )
         : ( S_HOLD[c] = S_FAST[c]; );

  // PUNCH's gain. Right of centre: a hit's attack is raised (the quick average
  // ahead of the slow one) and what follows it is pulled down (the level under
  // its own recent peak), both sized by how much of a hit the rise was. Left of
  // centre: attacks are softened by the same idea turned around.
  pn === 0 ? ( S_G[c] = 1; gp = 1; ) : pn < 0 ? (
    S_G[c] = 1;
    S_FAST[c] <= 0 ? ( gp = 1; ) : (
      ratio = S_SLOW[c] / S_FAST[c];
      ratio > 1 ? ratio = 1;
      gp = ratio ^ (-pn * C_SOFTEN_EXP) * soft_makeup;
    );
  ) : (
    hit = clamp((rise - 1) / (C_PUNCH_HIT_RISE - 1), 0, 1);
    S_HM[c] = max(S_HM[c] * k_hm, hit);
    kp = pn * C_PUNCH_SLOPE;
    target = clamp((rise ^ (kp * hit)) * (fall ^ (kp * S_HM[c])), punch_lo ^ pn, punch_hi ^ pn);
    S_G[c] = follow(S_G[c], target, fast_up, punch_dn);
    gp = S_G[c];
  );

  v = (faithful + tail) * gp;

  // TEXTURE: roughness everywhere except on a rising attack
  attack = clamp((rise - C_GRIT_HIT_FROM) / (C_PUNCH_HIT_RISE - C_GRIT_HIT_FROM), 0, 1);
  tx > 0 ? (
    S_TB[c] = S_TB[c] + k_tex * (attack - S_TB[c]);
    S_TB[c] < 0.0001 ? S_TB[c] = 0;
    v = v * (grit + S_TB[c] * (1 - grit));
  ) : (
    S_TB[c] = attack;
  );

  // INTENSITY: gain into a saturator (pin: 6 dB under the hardware ceiling up
  // to 100, opening up to it by 200). In the upper range
  // the waveform is made denser INSIDE its own envelope, so it gets harder
  // without the sound's rhythm being flattened.
  ai = gain * v / C_REF_PEAK;
  S_IE[c] = follow(S_IE[c], abs(ai), fast_up, fast_dn);
  (dense > 0 && S_IE[c] > 0.000001) ? (
    shaped = tanh_(C_DENSE_K * ai / S_IE[c]) * dense_norm * S_IE[c];
    ai = ai + dense * (shaped - ai);
  );
  y = pin * tanh_(ai);

  // FOCUS, right half: what the saturator put back into the lows (third-order
  // products of a band wider than an octave) is taken out again. The sections
  // always run and the result is faded in over the first tenth of the right
  // half, so that crossing the centre is no step.
  oh_y1 = oh_b1 * y + S_OH1[c];
  S_OH1[c] = -2 * oh_b1 * y - oh_a11 * oh_y1 + S_OH2[c];
  S_OH2[c] = oh_b1 * y - oh_a21 * oh_y1;
  oh_y2 = oh_b2 * oh_y1 + S_OH3[c];
  S_OH3[c] = -2 * oh_b2 * oh_y1 - oh_a12 * oh_y2 + S_OH4[c];
  S_OH4[c] = oh_b2 * oh_y1 - oh_a22 * oh_y2;
  y = y + focus_mix * (oh_y2 - y);

  // band limit, side weight
  S_PO1[c] = S_PO1[c] + k_ceiling * (y - S_PO1[c]);
  S_PO2[c] = S_PO2[c] + k_ceiling * (S_PO1[c] - S_PO2[c]);
  y = S_PO2[c] * weight * out_gain; // OUTPUT: the final level; the clamp below is its ceiling

  // a runaway or invalid value clears the state instead of reaching the hardware
  abs(y) <= 100 ? 0 : ( y = 0; clear_sides = 1; );

  // hardware policy: the last stage, and the only place output is limited
  y = max(-p_out_ceiling, min(p_out_ceiling, y));
  (y < C_SILENCE && y > -C_SILENCE) ? y = 0; // exact silence is reachable

  c == 0 ? ( yl = y; abs(y) > pk_l ? pk_l = abs(y); )
         : ( yr = y; abs(y) > pk_r ? pk_r = abs(y); );
  c += 1;
);

spl0 = yl;
spl1 = yr;