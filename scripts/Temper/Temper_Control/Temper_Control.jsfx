@init
ext_noinit = 1; // transport start must not reset the free-running counters
slider1 = 1;
first_block = 1; // seed smoothing state from the saved sliders in the first @block
last_pos = -1;   // play_position at the end of the last @block (restart rule)
was_playing = 0; // playing at the end of the last @block (restart rule)

// Memory map (plain offsets). [id] = source id, [u] = unit, [s] = slot,
// [i*12+s] = input i (0 A, 1 B, 2 C) of slot s.
ref_count = 0;   // [9..14] slots referencing LFO 1..4, follower 1..2
src_val = 16;    // [0..16] source values this block
src_ok = 40;     // [0..16] 1 unless soloed away
lfo_free = 60;   // [u] free-running seconds while stopped
lfo_sm = 64;     // [u] smoothed output
fol_env = 68;    // [u] envelope
fol_ms = 70;     // [u] RMS mean-square
fol_hold = 72;   // [u] hold counter (samples)
fol_sm = 74;     // [u] smoothed output
fol_in = 80;     // [u] cached params, set in @slider
fol_mode = 82;
fol_gain = 84;
fol_ca = 86;
fol_cr = 88;
fol_holdn = 90;
s_mode = 100;    // [s]
s_en = 112;
s_slew = 124;
s_held = 136;    // [s] input A's last active contribution
s_sm = 148;      // [s] slewed output
s_src = 160;     // [i*12+s]
s_lo = 196;
s_hi = 232;
s_cur = 268;
div_tab = 310;   // [0..19] beats per division; 14..19 are bar counts
memset(0, 0, 400);
div_tab[0] = 0.0625; div_tab[1] = 0.125; div_tab[2] = 1 / 6; div_tab[3] = 0.25;
div_tab[4] = 0.375; div_tab[5] = 1 / 3; div_tab[6] = 0.5; div_tab[7] = 0.75;
div_tab[8] = 1; div_tab[9] = 2 / 3; div_tab[10] = 1.5; div_tab[11] = 4 / 3;
div_tab[12] = 2; div_tab[13] = 3;
div_tab[14] = 1; div_tab[15] = 2; div_tab[16] = 4; div_tab[17] = 8;
div_tab[18] = 16; div_tab[19] = 32;

// Hash: bitwise-free and double-exact (twin of E.hash01).
function fmod32(x) ( x - floor(x / 4294967296) * 4294967296 );
function fmod16(x) ( x - floor(x / 65536) * 65536 );
function mulmod32(h, k) local(lo, hi) (
  lo = fmod16(h);
  hi = (h - lo) / 65536;
  fmod32(lo * k + fmod16(hi * k) * 65536);
);
function fold(h) local(lo, hi) (
  lo = fmod16(h);
  hi = (h - lo) / 65536;
  fmod32(h + hi);
);
function hash01(seed, k) local(h) (
  h = fmod32(seed * 2654435761 + k * 40503);
  h = mulmod32(h, 73244475);
  h = fold(h);
  h = mulmod32(h, 668265261);
  h = fold(h);
  h / 4294967296;
);

function clamp01(x) ( max(0, min(1, x)) );

// 0 linear, 1 x*x, 2 sqrt, 3 smoothstep (E.curve).
function crv(id, x) (
  x = clamp01(x);
  id == 1 ? x * x : id == 2 ? sqrt(x) : id == 3 ? x * x * (3 - 2 * x) : x;
);

function conn(lo, hi, cid, x) ( lo + (hi - lo) * crv(cid, x) );

// Quarter notes in one LFO cycle for division index d (E.DIV). Entries 0..13 are
// already quarter notes; 14..19 are bar counts, scaled by bar_qn (quarter notes
// per bar = ts_num * 4 / ts_denom), since beat_position counts quarter notes.
function div_beats(tab, d, bar_qn) local(i) (
  i = max(0, min(19, floor(d + 0.5)));
  i < 14 ? tab[i] : tab[i] * bar_qn;
);

// 0 sine, 1 tri, 2 saw up, 3 saw down, 4 square, 5 S&H, 6 smooth random (E.lfo).
function lfo_shape(shape, frac, cycle, seed) local(a, b, t) (
  shape == 0 ? 0.5 + 0.5 * sin(2 * $pi * frac) :
  shape == 1 ? (frac < 0.5 ? 2 * frac : 2 - 2 * frac) :
  shape == 2 ? frac :
  shape == 3 ? 1 - frac :
  shape == 4 ? (frac < 0.5 ? 1 : 0) :
  shape == 5 ? hash01(seed, cycle) :
  shape == 6 ? (
    a = hash01(seed, cycle);
    b = hash01(seed, cycle + 1);
    t = (1 - cos($pi * frac)) * 0.5;
    a + (b - a) * t;
  ) : 0;
);

// One-pole control-rate smoothing/slew over one block (E.slew).
function smooth_step(prev, target, ms, nsamp, sr) (
  ms > 0 ? prev + (target - prev) * (1 - exp(-(nsamp / sr) / (ms / 1000))) : target;
);

// Guarded slider write: only when the value moved by more than 0.000001.
function setsl(idx, v) (
  abs(v - slider(idx)) > 0.000001 ? ( slider(idx) = v; );
);

@slider
// Cache every slot's parameters and recount unit references.
id = 9;
loop(6, ref_count[id] = 0; id += 1;);
s = 0;
loop(12,
  base = 60 + s * 16;
  s_mode[s] = floor(slider(base) + 0.5);
  s_en[s] = slider(base + 1) >= 0.5;
  s_slew[s] = slider(base + 2);
  i = 0;
  loop(3,
    ib = base + 4 + i * 4;
    idx = i * 12 + s;
    src = floor(slider(ib) + 0.5);
    s_src[idx] = src;
    s_lo[idx] = slider(ib + 1);
    s_hi[idx] = slider(ib + 2);
    s_cur[idx] = floor(slider(ib + 3) + 0.5);
    b = src > 16 ? src - 16 : src; // a bypassed twin still counts as a reference
    (b >= 9 && b <= 14) ? ( ref_count[b] += 1; );
    i += 1;
  );
  s += 1;
);
u = 0;
loop(2,
  fb = 44 + u * 8;
  fol_in[u] = floor(slider(fb) + 0.5);
  fol_mode[u] = floor(slider(fb + 1) + 0.5);
  fol_gain[u] = exp(slider(fb + 2) * log(10) / 20);
  fol_ca[u] = exp(-1 / (max(slider(fb + 3), 0.1) * 0.001 * srate));
  fol_cr[u] = exp(-1 / (max(slider(fb + 4), 0.1) * 0.001 * srate));
  fol_holdn[u] = slider(fb + 5) * 0.001 * srate;
  u += 1;
);

@block
blk_t = samplesblock / srate;
playing = play_state & 1;
tempo_s = max(tempo, 1);
bar_qn = (ts_denom > 0 && ts_num > 0) ? ts_num * 4 / ts_denom : 4;

// 0. First block after load: resume where the saved sliders left off.
first_block ? (
  u = 0;
  loop(4, lfo_sm[u] = slider(12 + u * 8 + 7); u += 1;);
  u = 0;
  loop(2, fol_sm[u] = slider(44 + u * 8 + 7); u += 1;);
  s = 0;
  loop(12, s_sm[s] = slider(60 + s * 16 + 3); s += 1;);
  seed_held = 1; // s_held is seeded in 3b, once this block's sources are known
  last_pos = play_position; // block 1 is not a jump
  was_playing = playing;
  first_block = 0;
);

// 0b. Restart (only while playing): snaps the smoothing (1, 4) and restarts
// the followers (2).
jumped = playing && (!was_playing || play_position < last_pos - 0.000000001 ||
  play_position - last_pos > max(0.5, blk_t * 16));
timeline = playing; // LFO phase from the timeline, else the free counters

// 1. LFOs
u = 0;
loop(4,
  (ref_count[9 + u] > 0) ? (
    b = 12 + u * 8;
    sync = slider(b + 3) >= 0.5;
    rate = slider(b + 1);
    cyc_beats = div_beats(div_tab, slider(b + 2), bar_qn);
    sync ? (
      timeline ? ( raw = beat_position / cyc_beats; ) : (
        lfo_free[u] += blk_t;
        raw = lfo_free[u] / (cyc_beats * 60 / tempo_s);
      );
    ) : (
      timeline ? ( raw = play_position * rate; ) : (
        lfo_free[u] += blk_t;
        raw = lfo_free[u] * rate;
      );
    );
    raw += slider(b + 4);
    cycle = floor(raw);
    frac = raw - cycle;
    v = lfo_shape(floor(slider(b) + 0.5), frac, cycle, slider(b + 5));
    jumped ? ( lfo_sm[u] = v; ) : (
      lfo_sm[u] = smooth_step(lfo_sm[u], v, slider(b + 6), samplesblock, srate);
    );
    setsl(b + 7, lfo_sm[u]);
  );
  u += 1;
);

// 2. Followers (envelope comes from @sample)
u = 0;
loop(2,
  (ref_count[13 + u] > 0) ? (
    b = 44 + u * 8;
    jumped ? (
      fol_env[u] = 0; // restart the detector from silence
      fol_ms[u] = 0;
      fol_hold[u] = 0;
      fol_sm[u] = 0;
    ) : (
      fol_sm[u] = smooth_step(fol_sm[u], min(fol_env[u], 1), slider(b + 6), samplesblock, srate);
    );
    setsl(b + 7, fol_sm[u]);
  );
  u += 1;
);

// 3. Solo and the source table
solo = floor(slider(2) + 0.5);
solo_base = solo > 16 ? solo - 16 : solo;
id = 1;
loop(8, src_val[id] = slider(3 + id); src_ok[id] = 1; id += 1;);
loop(4, src_val[id] = slider(12 + (id - 9) * 8 + 7); src_ok[id] = 1; id += 1;);
loop(2, src_val[id] = slider(44 + (id - 13) * 8 + 7); src_ok[id] = 1; id += 1;);
(solo_base >= 9 && solo_base <= 14) ? (
  id = 9;
  loop(6, src_ok[id] = (id == solo_base); id += 1;);
);

// 3b. First block only: an absolute slot whose A is inactive (bypassed, muted,
// disabled) holds A's last contribution. The saved out slider is A + B + C, so
// held = clamp01(saved_out - B_now - C_now); an active A is recomputed in 4.
seed_held ? (
  s = 0;
  loop(12,
    s_held[s] = 0;
    src = s_src[s];
    a_act = (src > 0 && src <= 16) && (s_en[s] != 0) && (src_ok[src] != 0);
    (s_mode[s] == 0 && !a_act) ? (
      bc = 0;
      i = 1;
      loop(2,
        idx = i * 12 + s;
        src = s_src[idx];
        ((src > 0 && src <= 16) && (s_en[s] != 0) && (src_ok[src] != 0)) ? (
          bc += conn(s_lo[idx], s_hi[idx], s_cur[idx], src_val[src]);
        );
        i += 1;
      );
      s_held[s] = clamp01(s_sm[s] - bc);
    );
    s += 1;
  );
  seed_held = 0;
);

// 4. Slots
s = 0;
loop(12,
  base = 60 + s * 16;
  mode = s_mode[s];
  en = s_en[s];
  sum = 0;
  i = 0;
  loop(3,
    idx = i * 12 + s;
    src = s_src[idx];
    act = 0;
    sval = 0;
    (src > 0 && src <= 16) ? (
      act = (en != 0) && (src_ok[src] != 0);
      sval = src_val[src];
    );
    lo = s_lo[idx];
    hi = s_hi[idx];
    (i == 0 && mode == 0) ? ( lo = clamp01(lo); hi = clamp01(hi); );
    c = act ? conn(lo, hi, s_cur[idx], sval) : 0;
    i == 0 ? (
      act ? (
        (mode == 0) ? ( c = clamp01(c); );
        s_held[s] = c;
      ) : (
        (mode == 0) ? ( c = s_held[s]; );
      );
    );
    sum += c;
    i += 1;
  );
  o = mode == 0 ? clamp01(sum) : 0.5 + max(-0.5, min(0.5, sum));
  s_sm[s] = jumped ? o : smooth_step(s_sm[s], o, s_slew[s], samplesblock, srate);
  setsl(base + 3, s_sm[s]);
  s += 1;
);
was_playing = playing;
last_pos = play_position;

@sample
// Follower detectors; audio is never written.
u = 0;
loop(2,
  (ref_count[13 + u] > 0) ? (
    l = spl(fol_in[u] * 2);
    r = spl(fol_in[u] * 2 + 1);
    g = fol_gain[u];
    fol_mode[u] == 0 ? ( x = max(abs(l), abs(r)) * g; ) : (
      fol_ms[u] += ((l * l + r * r) * 0.5 * g * g - fol_ms[u]) * (1 - fol_ca[u]);
      x = sqrt(fol_ms[u]);
    );
    x = min(max(x, 0), 1); // keep the stored envelope in 0..1 (1.0 = 0 dBFS)
    e = fol_env[u];
    x > e ? (
      e = fol_ca[u] * e + (1 - fol_ca[u]) * x;
      fol_hold[u] = fol_holdn[u];
    ) : (fol_hold[u] > 0) ? (
      fol_hold[u] -= 1;
    ) : (
      e = fol_cr[u] * e + (1 - fol_cr[u]) * x;
    );
    fol_env[u] = e;
  );
  u += 1;
);
